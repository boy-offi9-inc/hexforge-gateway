# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Auth - off by default. Every route trusts whoever can reach it (adb
# shell, filesystem write/delete, rebuilding APKs) when this is false,
# which is fine for a local single-user tool but not once it's reachable
# beyond localhost. Set AUTH_ENABLED=true and at least one key in
# API_KEYS to actually turn it on - AUTH_ENABLED=true with no keys set
# stays open (with a startup warning) rather than locking everyone out.
AUTH_ENABLED=false
API_KEYS=

# Storage backend - "local" (default) means workspaces/knowledge never
# touch Supabase, even if the SUPABASE_* vars below are set. Switch to
# "supabase" once there's a real reason to share state across
# devices/users (e.g. once a web interface exists).
STORAGE_BACKEND=local

# Local file-backed storage - active whenever STORAGE_BACKEND=local, and
# used as a fallback if STORAGE_BACKEND=supabase but a call fails at runtime.
DATA_DIR=./data

# Supabase - only used if STORAGE_BACKEND=supabase above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Layer - set AI_PROVIDER to one of: anthropic, groq, gemini, ollama,
# openai, openai-compatible. Only the settings matching your chosen
# provider are required.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Ollama - local models need no key (just "ollama serve" running).
# Cloud models (e.g. OLLAMA_MODEL=gpt-oss:120b-cloud) need OLLAMA_API_KEY -
# see https://docs.ollama.com/cloud.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3
OLLAMA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Generic OpenAI-compatible endpoint - LM Studio (default shown), llama.cpp's
# server, vLLM, text-generation-webui, OpenRouter, etc. OPENAI_COMPATIBLE_MODEL
# has no default - it depends entirely on what you're running/pointing at.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# MCP Runtime
MCP_RUNTIME_MODE=local
WORKSPACES_ROOT=./workspaces

# Plugin System - comma-separated plugin names to load, e.g. "example-strings".
# Leave blank to load every plugin found under plugins/installed/.
PLUGINS_ENABLED=

# webhook-notifier plugin (plugins/installed/webhook-notifier/) - if set,
# POSTs to this URL when a Job or Workflow completes or fails. Leave
# blank to leave the plugin loaded but idle.
WEBHOOK_NOTIFIER_URL=
