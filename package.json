{
  "name": "hexforge-gateway",
  "version": "0.1.0",
  "description": "HexForge Gateway - core API layer for the HexForge reverse engineering workspace",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "mcp-server:dev": "tsx src/mcp-server/index.ts",
    "mcp-server": "node dist/mcp-server/index.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
