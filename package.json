{
  "name": "hexforge-gateway",
  "version": "1.3.10",
  "description": "Self-hosted reverse-engineering workspace API - orchestrates jadx, apktool, adb, frida and APKiD through a job and workflow engine, exposed as native MCP tools for Claude. No cloud required.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boy-offi9-inc/hexforge-gateway.git"
  },
  "homepage": "https://github.com/boy-offi9-inc/hexforge-gateway#readme",
  "bugs": {
    "url": "https://github.com/boy-offi9-inc/hexforge-gateway/issues"
  },
  "keywords": [
    "mcp",
    "android",
    "apk",
    "reverse-engineering",
    "jadx",
    "apktool",
    "frida",
    "adb",
    "claude",
    "termux"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,scripts,tests}/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"{src,scripts,tests}/**/*.{ts,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "hf": "node scripts/hf/cli.mjs",
    "mcp-server:dev": "tsx src/mcp-server/index.ts",
    "mcp-server": "node dist/mcp-server/index.js",
    "mcp-server-http:dev": "tsx src/mcp-server/http.ts",
    "mcp-server-http": "node dist/mcp-server/http.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
